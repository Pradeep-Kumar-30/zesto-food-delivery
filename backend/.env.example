# Copy to .env for local/production.

NODE_ENV=development

PORT=5000

# Comma-separated browser origins allowed to call this API (CORS + Socket.io)
FRONTEND_URL=http://localhost:5173

MONGODB_URL=
JWT_SECRET=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nodemailer
EMAIL=
PASS=

# Razorpay (server)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cookies: production defaults to secure=true, sameSite=none (SPA + API different hosts).
# Same-site deploy (one domain): set COOKIE_SAME_SITE=lax and COOKIE_SECURE=true
COOKIE_SECURE=
COOKIE_SAME_SITE=
COOKIE_DOMAIN=
